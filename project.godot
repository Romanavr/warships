; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="3DGame — Littoral"
config/description="A small, destructible naval patrol sandbox."
run/main_scene="res://scenes/patrol.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]

; WebGL 2 in the browser. This is Godot's default for the web target, but it is
; stated because the whole effect budget hangs off it: `Vfx.rich()` and
; `FireSource.rich()` both ask the rendering server which method is live and cut
; particle counts, glow and tracer detail when the answer is not forward_plus.
; If this ever silently became something else the browser build would try to run
; the desktop effect load.
renderer/rendering_method.web="gl_compatibility"

; Required for a universal / arm64 macOS export: Godot refuses the build
; without it, because an Apple Silicon slice needs ASTC-compressed textures.
textures/vram_compression/import_etc2_astc=true

textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.055, 0.12, 0.16, 1)
textures/default_filters/use_nearest_mipmap_filter.mobile=false
